thanos:priority a owl:DatatypeProperty ;
    rdfs:comment "P1 | P2 | P3 | P4." ;
    rdfs:domain thanos:Vulnerability ;
    rdfs:range xsd:string .

thanos:priorityLabel a owl:DatatypeProperty ;
    rdfs:comment "Review priority P1 to P4 computed by the core scoring." ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:string .

thanos:rationale a owl:DatatypeProperty ;
    rdfs:comment "Textual rationale for the finding." ;
    rdfs:domain thanos:Vulnerability ;
    rdfs:range xsd:string .

thanos:score a owl:DatatypeProperty ;
    rdfs:comment "Aggregated criticality score of the binary in the dashboard." ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:integer .

thanos:severity a owl:DatatypeProperty ;
    rdfs:comment "critical | high | medium | low." ;
    rdfs:domain thanos:Vulnerability ;
    rdfs:range xsd:string .

thanos:sha256After a owl:DatatypeProperty ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:string .

thanos:sha256Before a owl:DatatypeProperty ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:string .

thanos:sizeDelta a owl:DatatypeProperty ;
    rdfs:comment "Size difference (bytes) between AFTER and BEFORE." ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:integer .

thanos:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:comment "The AFTER KB supersedes the BEFORE KB of the cycle pair." ;
    rdfs:domain thanos:KB ;
    rdfs:range thanos:KB .

thanos:targetBuild a owl:DatatypeProperty ;
    rdfs:comment "Target build, e.g. 20348.5020." ;
    rdfs:range xsd:string .

thanos:targetProduct a owl:DatatypeProperty ;
    rdfs:range xsd:string .

thanos:title a owl:DatatypeProperty ;
    rdfs:comment "Title published by MSRC." ;
    rdfs:domain thanos:CVE ;
    rdfs:range xsd:string .

thanos:versionAfter a owl:DatatypeProperty ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:string .

thanos:versionBefore a owl:DatatypeProperty ;
    rdfs:domain thanos:Binary ;
    rdfs:range xsd:string .

