thanos:MSU a owl:Class ;
    rdfs:label "MSU package" ;
    rdfs:comment "The downloadable .msu file associated with a KB." .

thanos:PatchCycle a owl:Class ;
    rdfs:label "Patch Tuesday cycle" ;
    rdfs:comment "A monthly update cycle, e.g. '2026-04 Patch Tuesday'." .

thanos:cycle-2026-04-patch-tuesday a thanos:PatchCycle ;
    rdfs:label "2026-04 Patch Tuesday" ;
    thanos:cycleLabel "2026-04 Patch Tuesday" ;
    thanos:targetBuild "20348.5020" ;
    thanos:targetProduct "Windows Server 2022" .

thanos:KB a owl:Class ;
    rdfs:label "Knowledge Base update" ;
    rdfs:comment "A cumulative update identified by its KB id (e.g. KB5078766)." .

thanos:Vulnerability a owl:Class ;
    rdfs:label "Assessed vulnerability" ;
    rdfs:comment "Finding prioritized by Thanos Auditor for a binary (severity, priority, confidence)." .

thanos:Package a owl:Class ;
    rdfs:label "SXS package" ;
    rdfs:comment "A component package (SXS folder) that groups binaries." .

thanos:cycle-2026-04-patch-tuesday-full a thanos:PatchCycle ;
    rdfs:label "2026-04 Patch Tuesday FULL" ;
    thanos:cycleLabel "2026-04 Patch Tuesday FULL" ;
    thanos:targetBuild "20348.5020" ;
    thanos:targetProduct "Windows Server 2022" .

thanos:Binary a owl:Class ;
    rdfs:label "Binary (DLL)" ;
    rdfs:comment "A rebuilt binary whose content changes between two cycles." .

thanos:kb-kb5082142 a thanos:KB ;
    rdfs:label "KB5082142" ;
    thanos:kbId "KB5082142" ;
    thanos:partOfCycle thanos:cycle-2026-04-patch-tuesday,
        thanos:cycle-2026-04-patch-tuesday-full ;
    thanos:supersedes thanos:kb-kb5078766 .

thanos:CVE a owl:Class ;
    rdfs:label "CVE" ;
    rdfs:comment "A public vulnerability identifier (e.g. CVE-2026-1234)." .

