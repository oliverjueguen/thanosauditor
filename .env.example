# ============================================================================
# Thanos: example environment variables.
# Copy this file to `.env` (the CLIs and the dashboard load it at startup, without
# overriding variables already exported). NEVER commit `.env` to the repository.
# ============================================================================

# --- Thanos Auditor (Claude Agent SDK) ---
# Thanos Auditor uses the user's own Claude session on this machine:
#   python -m thanos.auditor.cli login     (once; opens the Claude sign-in)
#   python -m thanos.auditor.cli status    (checks the session)
# No key is needed here to use the subscription.
THANOS_AUDITOR_MODEL=claude-opus-5-5
#
# Alternatives (optional). NOTE: if ANTHROPIC_API_KEY is set, it takes
# precedence over the subscription and is billed per token.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Web dashboard ---
THANOS_PANEL_HOST=127.0.0.1
THANOS_PANEL_PORT=8000
# Directory where the dashboard stores uploaded bundles (ignored by git).
THANOS_PANEL_DATA=data/panel/bundles
# 1 = when starting with an empty dashboard, seed the real bundles from fixtures/bundles.
THANOS_PANEL_SEED=1
# Optional upload token: if set, POST /upload requires it (form field or
# X-Thanos-Token header). Empty = no token (local use on 127.0.0.1).
THANOS_PANEL_TOKEN=
# Maximum size per uploaded file, in MB.
THANOS_PANEL_MAX_UPLOAD_MB=5
# Thanos Auditor report shown by the dashboard next to the heuristic score.
THANOS_PANEL_REPORT=output/report.json

# --- Ontology (catalog that replaces Neo4j) ---
THANOS_ONTOLOGY_CATALOG=data/ontology/catalog.ttl
# Real MSRC CVEs (CVRF) for the cycle, stored locally (offline).
THANOS_MSRC_CVES=fixtures/msrc/2026-Apr.ws2022.json

# --- Structured logging (JSON lines on stderr) ---
# DEBUG | INFO | WARNING | ERROR. Defaults to WARNING in the CLIs and INFO in the dashboard.
# THANOS_LOG_LEVEL=INFO
